<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email &amp; SMTP Settings - Admin</title>
    <link rel="stylesheet" href="/css/admin-add-vehicle.css">
    <style>
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 25px;
        }
        .status-badge.active {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #10b981;
        }
        .status-badge.inactive {
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: #fbbf24;
        }
        .info-card {
            background: rgba(0, 210, 255, 0.08);
            border: 1px solid rgba(0, 210, 255, 0.25);
            border-radius: 10px;
            padding: 16px 20px;
            margin-bottom: 25px;
            font-size: 13px;
            color: #cbd5e1;
            line-height: 1.6;
        }
        .info-card strong { color: #00d2ff; }
        .btn-submit {
            background: linear-gradient(135deg, #00d2ff, #0090b3);
            color: #000;
            border: none;
            padding: 14px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0, 210, 255, 0.4);
        }
        .test-box {
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid #2a2a4a;
        }
        .test-result {
            margin-top: 12px;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            display: none;
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/admin" class="navbar-brand">CARBIKE <span>Admin</span></a>
        <div class="nav-right">
            <a href="/admin/dashboard" class="nav-link btn-back">Dashboard</a>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Email (SMTP) Settings</h1>
            <p>Configure automated OTP delivery directly to users' personal email inboxes.</p>
        </div>

        <div class="form-card">
            <% if (typeof saved !== 'undefined' && saved) { %>
                <div style="background: rgba(16,185,129,0.15); border: 1px solid #10b981; color: #10b981; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px;">
                    &#10004; Email settings successfully saved! OTP dispatch service is now active.
                </div>
            <% } %>

            <% if (configured) { %>
                <div class="status-badge active">
                    <span style="font-size:16px;">&#9679;</span> Real Email Delivery Active (<%= config.user %>)
                </div>
            <% } else { %>
                <div class="status-badge inactive">
                    <span style="font-size:16px;">&#9679;</span> Email Delivery Offline (Test Mode Active)
                </div>
            <% } %>

            <div class="info-card">
                <strong>How to send OTPs to personal Gmail addresses:</strong><br>
                1. Use your Gmail address (e.g. <code>saisugnan25@gmail.com</code>).<br>
                2. In your Google Account: Go to <strong>Security &rarr; 2-Step Verification &rarr; App passwords</strong>.<br>
                3. Create an app password named <em>CarRental</em> and paste the 16-character password below.<br>
                4. Click <strong>Save Settings</strong> and send a test email. OTPs will instantly deliver to customers' personal inboxes!
            </div>

            <form action="/admin/email-settings" method="post">
                <div class="form-row">
                    <div class="form-group">
                        <label>SMTP Host</label>
                        <input type="text" name="host" value="<%= config.host || 'smtp.gmail.com' %>" required>
                    </div>
                    <div class="form-group">
                        <label>SMTP Port</label>
                        <input type="number" name="port" value="<%= config.port || 587 %>" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Sender Email Address</label>
                        <input type="email" name="user" value="<%= config.user || '' %>" placeholder="e.g. saisugnan25@gmail.com" required>
                    </div>
                    <div class="form-group">
                        <label>Google App Password (16 Characters)</label>
                        <input type="password" name="pass" value="<%= config.pass || '' %>" placeholder="e.g. abcd efgh ijkl mnop" required>
                    </div>
                </div>

                <div class="form-group form-full">
                    <label>Sender Display Name</label>
                    <input type="text" name="from" value="<%= config.from || 'Car & Bike Rental' %>" placeholder="Car &amp; Bike Rental">
                </div>

                <div style="display: flex; gap: 15px; align-items: center; margin-top: 10px;">
                    <button type="submit" class="btn-submit">&#128190; Save Email Settings</button>
                </div>
            </form>

            <div class="test-box">
                <h3 style="font-size: 16px; margin-bottom: 8px; color: #fff;">Test Email Dispatch</h3>
                <p style="font-size: 13px; color: #888; margin-bottom: 14px;">Send a test OTP to verify that emails arrive in your personal inbox.</p>
                <div style="display: flex; gap: 12px; max-width: 500px;">
                    <input type="email" id="testEmailInput" placeholder="recipient@gmail.com" value="<%= config.user || 'saisugnan25@gmail.com' %>" style="flex: 1; padding: 10px 14px; background: #0f0f1a; border: 1px solid #2a2a4a; border-radius: 8px; color: #fff; font-size: 14px;">
                    <button type="button" id="btnTestEmail" onclick="sendTestEmail()" style="background: rgba(0, 210, 255, 0.15); border: 1px solid #00d2ff; color: #00d2ff; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; white-space: nowrap;">Send Test</button>
                </div>
                <div id="testResult" class="test-result"></div>
            </div>
        </div>
    </div>

    <script>
        async function sendTestEmail() {
            var emailInput = document.getElementById('testEmailInput');
            var btn = document.getElementById('btnTestEmail');
            var resEl = document.getElementById('testResult');
            var email = emailInput.value.trim();

            if (!email) {
                resEl.style.display = 'block';
                resEl.style.background = 'rgba(239, 68, 68, 0.15)';
                resEl.style.border = '1px solid #ef4444';
                resEl.style.color = '#ef4444';
                resEl.textContent = 'Please enter a recipient email.';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Sending...';
            resEl.style.display = 'none';

            try {
                var response = await fetch('/admin/email-settings/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                var data = await response.json();
                resEl.style.display = 'block';

                if (data.success) {
                    resEl.style.background = 'rgba(16, 185, 129, 0.15)';
                    resEl.style.border = '1px solid #10b981';
                    resEl.style.color = '#10b981';
                    resEl.textContent = '✔ Success! Test OTP email delivered to ' + email + '. Check your inbox and spam folder.';
                } else {
                    resEl.style.background = 'rgba(239, 68, 68, 0.15)';
                    resEl.style.border = '1px solid #ef4444';
                    resEl.style.color = '#ef4444';
                    resEl.textContent = '✖ Error sending email: ' + (data.error || 'Check SMTP credentials.');
                }
            } catch (err) {
                resEl.style.display = 'block';
                resEl.style.background = 'rgba(239, 68, 68, 0.15)';
                resEl.style.border = '1px solid #ef4444';
                resEl.style.color = '#ef4444';
                resEl.textContent = '✖ Network error: ' + err.message;
            } finally {
                btn.disabled = false;
                btn.textContent = 'Send Test';
            }
        }
    </script>
</body>
</html>
