<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users - Admin</title>
    <link rel="stylesheet" href="/css/admin-users.css">
</head>
<body>

    <nav class="navbar">
        <a href="/admin" class="navbar-brand">CARBIKE <span>Admin</span></a>
        <div class="nav-right">
            <a href="/admin/dashboard" class="nav-link btn-back">Dashboard</a>
        </div>
    </nav>

    <div class="container">
        <div class="header">
            <h1>Registered Users</h1>
        </div>

        <% if (!users || users.length === 0) { %>
            <div class="table-wrap">
                <div class="empty-state">
                    <p>No users registered yet.</p>
                </div>
            </div>
        <% } else { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function(u) { %>
                            <tr>
                                <td><%= u.id.toString().substring(0, 8) %></td>
                                <td><strong><%= u.fullName %></strong></td>
                                <td><%= u.email %></td>
                                <td><%= u.phone || '-' %></td>
                                <td>
                                    <span class="badge <%= u.role === 'ROLE_ADMIN' ? 'badge-admin' : 'badge-user' %>">
                                        <%= u.role === 'ROLE_ADMIN' ? 'ADMIN' : 'USER' %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge <%= u.enabled ? 'badge-enabled' : 'badge-disabled' %>">
                                        <%= u.enabled ? 'Active' : 'Disabled' %>
                                    </span>
                                </td>
                                <td>
                                    <% if (u.email !== 'admin@gmail.com') { %>
                                        <a href="/admin/users/delete/<%= u.id %>" class="btn-delete"
                                           onclick="return confirm('Are you sure you want to delete this user?')">Delete</a>
                                    <% } else { %>
                                        <span style="color:#777; font-size:12px;">Protected Admin</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <div class="footer">&copy; 2026 Car &amp; Bike Rental Admin Panel</div>

</body>
</html>
