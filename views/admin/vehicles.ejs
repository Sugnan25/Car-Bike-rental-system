<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Vehicles - Admin</title>
    <link rel="stylesheet" href="/css/admin-vehicles.css">
</head>
<body>

    <nav class="navbar">
        <a href="/admin" class="navbar-brand">CARBIKE <span>Admin</span></a>
        <div class="nav-right">
            <a href="/admin/dashboard" class="nav-link btn-back">Dashboard</a>
        </div>
    </nav>

    <div class="container">
        <div class="header">
            <h1>Manage Vehicles</h1>
            <div style="display:flex; gap:10px;">
                <a href="/admin/vehicles/clear" class="btn-clear"
                   onclick="return confirm('Are you sure you want to delete ALL vehicles?')">Clear All</a>
                <a href="/admin/vehicles/add" class="btn-add">+ Add Vehicle</a>
            </div>
        </div>

        <% if (!vehicles || vehicles.length === 0) { %>
            <div class="table-wrap">
                <div class="empty-state">
                    <p>No vehicles found. Add your first vehicle to get started.</p>
                </div>
            </div>
        <% } else { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Type</th>
                            <th>Company</th>
                            <th>Model</th>
                            <th>Number</th>
                            <th>Price/KM</th>
                            <th>Fuel</th>
                            <th>Available</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% vehicles.forEach(function(vehicle) { %>
                            <tr>
                                <td style="width: 60px;">
                                    <% if (vehicle.imageUrl) { %>
                                        <img src="<%= vehicle.imageUrl %>" alt="<%= vehicle.model %>" style="width:50px; height:35px; object-fit:cover; border-radius:4px;">
                                    <% } else { %>
                                        <span style="font-size: 24px;"><%- vehicle.type === 'CAR' ? '&#128663;' : '&#128690;' %></span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge <%= vehicle.type === 'CAR' ? 'badge-car' : 'badge-bike' %>">
                                        <%= vehicle.type %>
                                    </span>
                                </td>
                                <td><%= vehicle.company %></td>
                                <td><%= vehicle.model %></td>
                                <td><strong><%= vehicle.vehicleNumber %></strong></td>
                                <td>&#8377; <%= vehicle.pricePerKm %></td>
                                <td><%= vehicle.fuelType %></td>
                                <td>
                                    <span class="badge <%= vehicle.available ? 'badge-yes' : 'badge-no' %>">
                                        <%= vehicle.available ? 'Available' : 'Unavailable' %>
                                    </span>
                                </td>
                                <td>
                                    <div class="actions">
                                        <a href="/admin/vehicles/edit/<%= vehicle.id %>" class="btn-edit">Edit</a>
                                        <a href="/admin/vehicles/delete/<%= vehicle.id %>" class="btn-delete"
                                           onclick="return confirm('Are you sure you want to delete this vehicle?')">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <div class="footer">&copy; 2026 Car &amp; Bike Rental Admin Panel</div>

</body>
</html>
