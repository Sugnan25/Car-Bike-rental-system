<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Car &amp; Bike Rental</title>
    <link rel="stylesheet" href="/css/login.css">
    <style>
        .demo-box {
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 8px;
            padding: 12px 14px;
            margin-bottom: 20px;
            font-size: 13px;
            color: #93c5fd;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .btn-fill-otp {
            background: #3b82f6;
            border: none;
            color: #fff;
            padding: 5px 12px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .info-pill {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.25);
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 12px;
            color: #fbbf24;
            margin-bottom: 16px;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <div class="left">
        <h1>Car &amp; Bike Rental</h1>
        <p>Set a new password for your account. You can sign in immediately after resetting.</p>
    </div>

    <div class="right">
        <div class="form-box">
            <h2>Set New Password</h2>
            <p class="subtitle">Reset code sent for <strong><%= email %></strong></p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div style="background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid #ef4444; padding: 10px 14px; border-radius: 8px; margin-bottom: 18px; font-size: 13px;">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof demoOtp !== 'undefined' && demoOtp) { %>
                <div class="demo-box">
                    <span>Password Reset Code: <strong style="font-size:16px; color:#fff; letter-spacing:1px;"><%= demoOtp %></strong></span>
                    <button type="button" class="btn-fill-otp" onclick="document.getElementById('otpInput').value = '<%= demoOtp %>'">Auto-Fill Code</button>
                </div>
            <% } %>

            <div class="info-pill">
                &#9432; If email is not delivered to your personal mail, use the reset code shown above (or universal code <strong>123456</strong>).
            </div>

            <form action="/reset-password" method="post">
                <input type="hidden" name="email" value="<%= email %>">

                <div class="form-group">
                    <label>6-Digit Reset Code (OTP)</label>
                    <input type="text" id="otpInput" name="otp" placeholder="Enter 6-digit code" maxlength="6" required autofocus>
                </div>

                <div class="form-group">
                    <label>New Password</label>
                    <div class="password-field">
                        <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password (min. 6 chars)" minlength="6" required>
                        <button type="button" class="toggle-password" aria-label="Show password"
                                onclick="togglePassword('newPassword', this)">
                            <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Confirm New Password</label>
                    <div class="password-field">
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" minlength="6" required>
                        <button type="button" class="toggle-password" aria-label="Show password"
                                onclick="togglePassword('confirmPassword', this)">
                            <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-submit">Reset &amp; Save Password</button>
            </form>

            <div class="form-footer">
                <a href="/login" style="color: #888; font-size: 13px;">&larr; Back to Sign In</a>
            </div>
        </div>
    </div>

    <script src="/js/password-toggle.js"></script>
</body>
</html>
