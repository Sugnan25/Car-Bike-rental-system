<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - Car &amp; Bike Rental</title>
    <link rel="stylesheet" href="/css/user-settings.css">
</head>
<body>

    <nav class="navbar">
        <a href="/" class="navbar-brand">CARBIKE <span>Rental</span></a>
        <div class="nav-right">
            <a href="/user/dashboard" class="nav-link btn-home">Dashboard</a>
            <a href="/user/bookings" class="nav-link btn-home">My Bookings</a>
            <form action="/logout" method="post" style="display:inline;">
                <button type="submit" class="nav-link btn-primary" style="border:none; cursor:pointer; background:none; font:inherit;">Logout</button>
            </form>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Account Settings</h1>
            <p>Update your profile details and change your password.</p>
        </div>

        <% if (params.saved) { %>
            <div class="alert alert-success">
                &#9989; Your account has been updated successfully.
            </div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-error">
                &#9888; <%= error %>
            </div>
        <% } %>

        <div class="settings-card">
            <form action="/user/settings" method="post">

                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" name="fullName" value="<%= user ? user.fullName : '' %>" required>
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 7px;">
                        <label style="margin: 0;">Email Address</label>
                        <% if (user && user.emailVerified) { %>
                            <span style="display: inline-flex; align-items: center; gap: 4px; background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #10b981; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700;">
                                &#10004; Verified
                            </span>
                        <% } else { %>
                            <button type="button" onclick="triggerSettingsEmailOtp()" style="background: rgba(0, 210, 255, 0.15); border: 1px solid #00d2ff; color: #00d2ff; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer;">
                                Verify Email Now &rarr;
                            </button>
                        <% } %>
                    </div>
                    <input type="email" id="settingsEmail" value="<%= user ? user.email : '' %>" readonly class="readonly">
                    
                    <div id="settingsOtpBox" style="display: none; margin-top: 10px; background: rgba(0, 210, 255, 0.05); border: 1px dashed #00d2ff; padding: 12px; border-radius: 8px;">
                        <div style="font-size: 12px; color: #aaa; margin-bottom: 6px;">Enter the 6-digit code sent to your email:</div>
                        <div style="display: flex; gap: 8px;">
                            <input type="text" id="settingsOtpInput" placeholder="Enter OTP" maxlength="6" style="flex:1; background:#0f0f1a; border:1px solid #2a2a4a; color:#00d2ff; padding:8px; border-radius:6px; font-weight:bold; letter-spacing:2px; text-align:center;">
                            <button type="button" onclick="verifySettingsOtp()" style="background:#00d2ff; border:none; color:#000; font-weight:bold; padding:8px 14px; border-radius:6px; cursor:pointer;">Confirm</button>
                        </div>
                        <div id="settingsOtpDemo" style="display:none; font-size:11px; color:#38bdf8; margin-top:6px;">Demo Code: <strong id="settingsDemoVal"></strong></div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="text" name="phone" value="<%= user ? user.phone : '' %>" required>
                </div>

                <div class="section-divider">
                    <span>Change Password</span>
                </div>
                <p class="hint">Leave the password fields empty to keep your current password.</p>

                <div class="form-row">
                    <div class="form-group">
                        <label>New Password</label>
                        <div class="password-field">
                            <input type="password" id="newPassword" name="newPassword" placeholder="New password">
                            <button type="button" class="toggle-password" aria-label="Show password"
                                    onclick="togglePassword('newPassword', this)">
                                <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Confirm New Password</label>
                        <div class="password-field">
                            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter new password">
                            <button type="button" class="toggle-password" aria-label="Show password"
                                    onclick="togglePassword('confirmPassword', this)">
                                <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-save">Save Changes</button>
                    <a href="/user/dashboard" class="btn-cancel">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="footer">&copy; 2026 Car &amp; Bike Rental. All rights reserved.</div>

    <script src="/js/password-toggle.js"></script>
    <script>
        async function triggerSettingsEmailOtp() {
            var email = document.getElementById('settingsEmail').value;
            if (!email) return;

            try {
                var res = await fetch('/api/auth/send-verification-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                var data = await res.json();
                if (data.success) {
                    document.getElementById('settingsOtpBox').style.display = 'block';
                    if (data.demoOtp) {
                        document.getElementById('settingsDemoVal').textContent = data.demoOtp;
                        document.getElementById('settingsOtpDemo').style.display = 'block';
                    }
                } else {
                    alert(data.message || 'Failed to send OTP.');
                }
            } catch (e) {
                alert('Failed to connect to verification server.');
            }
        }

        async function verifySettingsOtp() {
            var email = document.getElementById('settingsEmail').value;
            var otp = document.getElementById('settingsOtpInput').value.trim();
            if (!otp) {
                alert('Please enter the OTP code.');
                return;
            }

            try {
                var res = await fetch('/api/auth/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, otp: otp })
                });
                var data = await res.json();
                if (data.success) {
                    alert('Email verified successfully!');
                    window.location.reload();
                } else {
                    alert(data.message || 'Invalid OTP code.');
                }
            } catch (e) {
                alert('Verification failed. Please try again.');
            }
        }
    </script>
</body>
</html>
